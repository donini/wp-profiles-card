{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cardpress",
  "account_id": "4c36203db208651b335d9806e5b0eb59",
  "main": "src/worker.ts",
  "compatibility_date": "2026-11-16",
  "workers_dev": true,
  "routes": [
    { "pattern": "cardpress.us", "custom_domain": true },
    { "pattern": "www.cardpress.us", "custom_domain": true }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/card", "/json", "/api/*", "/health"],
    "not_found_handling": "404-page"
  },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "cardpress",
    "database_id": "ccae7089-2f01-4c51-8c10-3c0fd10f93da",
    "migrations_dir": "migrations"
  }],
  "vars": { "DEMO_MODE": "false", "PROFILE_TTL_SECONDS": "86400" },
  "observability": { "enabled": true }
}
