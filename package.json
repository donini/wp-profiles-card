{
  "name": "cardpress-cloudflare",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "npm run db:local && wrangler dev --local --ip 127.0.0.1 --port 8787",
    "dev:demo": "npm run db:local && wrangler dev --local --ip 127.0.0.1 --port 8787 --var DEMO_MODE:true",
    "db:local": "wrangler d1 migrations apply DB --local",
    "typecheck": "tsc --noEmit",
    "build": "node scripts/build.mjs",
    "test": "npm run build && node --test tests/*.test.mjs",
    "check": "npm run typecheck && npm test",
    "sync:github": "node scripts/sync-github.mjs",
    "pages": "node scripts/pages.mjs",
    "sync:posts": "node scripts/sync-posts.mjs",
    "deploy": "npm run build && wrangler deploy",
    "db:remote": "wrangler d1 migrations apply DB --remote"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261116.1",
    "esbuild": "0.28.2",
    "miniflare": "5.20261116.0-beta",
    "typescript": "7.0.2",
    "wrangler": "4.163.0"
  },
  "dependencies": {
    "entities": "9.0.0"
  },
  "license": "ISC"
}
